table FactBookings
	lineageTag: 15625611-2e6d-4fcb-850e-c5c60e626b9e

	measure 'Rolling Avg (30 Days)' = ```
			
			CALCULATE (
			     FactBookings[Bookings Count],
			    DATESINPERIOD (
			        'Booking Calendar Table'[Date],
			        MAX ('Booking Calendar Table'[Date] ),
			        -30,                    
			        DAY
			    )
			)
			```
		lineageTag: e0644aa3-84a0-4316-b91c-3035f960e8c8

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Bookings per Host' = ```
			COUNT(FactBookings[Listing ID]) 
			```
		formatString: 0
		lineageTag: b59efb59-f0a1-4735-8610-62901c7277ee

		changedProperty = IsHidden

	measure 'Number of Bookings' = ```
			COUNT(FactBookings[Listing ID]) 
			```
		formatString: 0
		lineageTag: 61d11b78-f470-40af-9fa1-1b3f6e0d0d90

		changedProperty = IsHidden

	measure 'Previous Month Bookings' =
			CALCULATE(
			      [Number of Bookings],
			      PREVIOUSMONTH('Booking Calendar Table'[Date])
			)
		formatString: 0
		lineageTag: afe50ac2-d807-4148-81ad-acf2e1de883a

		changedProperty = IsHidden

	measure 'MoM Growth %' = ```
			
			 DIVIDE(
			    [Number of Bookings] - [Previous Month Bookings],
			    [Previous Month Bookings]
			 )
			```
		lineageTag: 538a2fbe-f8ad-4032-9eec-950ea7797603

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Bookings Count' =
			CALCULATE(COUNT(FactBookings[Listing ID]),
			FactBookings[Is Available Flag] = "No")
		formatString: 0
		lineageTag: 81374be7-6c6f-4510-b71e-b8beecbbdfc2

		changedProperty = IsHidden

