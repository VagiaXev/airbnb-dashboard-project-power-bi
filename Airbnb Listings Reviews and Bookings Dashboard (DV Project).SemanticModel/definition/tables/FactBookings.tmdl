	/// The price per night for the listings at this period
	column 'Booking Price'
		dataType: double
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 76252616-61f2-47b1-adb5-0efac610a035
		summarizeBy: sum
		sourceColumn: Booking Price

