		sourceColumn: Comments

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Is Available Flag'
		dataType: string
		lineageTag: fc74a669-8640-4169-810c-cac4e5356e79
		summarizeBy: none
		sourceColumn: Is Available Flag

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

