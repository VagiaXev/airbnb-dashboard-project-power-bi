table FactReviews
	lineageTag: 628b8c36-1ad3-44f9-aa47-287220186071

	measure Running_Total_reviews =
			
			CALCULATE(
			    COUNT(FactReviews[Review ID]),
			    FILTER(
			        ALLSELECTED('Reviews Calendar Table'),
			        'Reviews Calendar Table'[Date] <=
			MAX('Reviews Calendar Table'[Date])
			    )
			)
		formatString: 0
		lineageTag: f683c32e-d24f-462b-96e3-7db76dfe2e96

		changedProperty = IsHidden

	/// The review id
	column 'Review ID'
		dataType: int64
		isKey
		isNullable: false
		formatString: 0
		lineageTag: d434ba81-3565-441f-84ba-aa0095f3c69b
		summarizeBy: none
		sourceColumn: Review ID

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	/// The listing id
	column 'Listing ID'
		dataType: int64
		formatString: 0
		lineageTag: 21517fe7-15ff-4fed-9b11-5271ee536173
		summarizeBy: none
		sourceColumn: Listing ID

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

