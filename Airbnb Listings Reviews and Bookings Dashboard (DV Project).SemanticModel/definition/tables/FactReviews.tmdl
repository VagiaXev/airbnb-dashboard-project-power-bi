		formatString: 0
		lineageTag: 9413b7ba-f1f6-4d77-8d80-62a2f65819d1
		summarizeBy: none
		sourceColumn: Reviewer ID

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// The review date
	column 'Review Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: c74ba376-def3-462c-97d1-115f3455ab7c
		summarizeBy: none
		sourceColumn: Review Date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

